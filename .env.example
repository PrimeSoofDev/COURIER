# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gaatitrack
DB_USER=root
DB_PASS=

# Application Configuration
APP_NAME=GaaTiTrack
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/courer

# Timezone
APP_TIMEZONE=Asia/Kolkata

# Secret key for CSRF and sessions
APP_SECRET=gaatitrack_change_this_secret_in_production_key_32bytes

# Mail / Mailtrap SMTP Configuration
MAIL_DRIVER=smtp
MAIL_FROM_ADDRESS=no-reply@gaatitrack.com
MAIL_FROM_NAME=GaaTiTrack Logistics
MAIL_SMTP_HOST=sandbox.smtp.mailtrap.io
MAIL_SMTP_PORT=2525
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
MAIL_SMTP_SECURITY=tls
MAIL_USE_SMTP=true
